# Local Compose/development. Keep actual .env files out of Git.
APP_ENV=development
APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
# Blank derives ws:// or wss:// from the API origin.
VITE_WS_BASE_URL=
DATABASE_URL=
DATABASE_PATH=fivebones.sqlite3
ALLOWED_ORIGINS=http://localhost:5173,https://app.roll20.net
# Omit this line to inherit ALLOWED_ORIGINS; an explicitly blank list denies all socket origins.
WS_ALLOWED_ORIGINS=http://localhost:5173,https://app.roll20.net
HOST_INVITE_SECRET=
RETENTION_DAYS=30
